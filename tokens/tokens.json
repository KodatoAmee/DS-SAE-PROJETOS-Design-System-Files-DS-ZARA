{
  "$description": "DS-Zara. Fonte canônica dos tokens (W3C DTCG). Valores medidos em zara.com/pt em 2026-11-19 (DOM a 1440px). theme.css espelha este arquivo.",
  "color": {
    "$type": "color",
    "primitive": {
      "black": { "$value": "#000000" },
      "white": { "$value": "#ffffff" },
      "gray-005": { "$value": "#f2f2f2" },
      "gray-010": { "$value": "#e5e5e5" },
      "gray-020": { "$value": "#cccccc" },
      "gray-040": { "$value": "#999999" },
      "gray-055": { "$value": "#797979", "$description": "Linha inferior de campo." },
      "gray-058": { "$value": "#6b6b6b", "$description": "Rótulo de campo." },
      "gray-060": { "$value": "#666666" },
      "gray-080": { "$value": "#333333" },
      "gray-085": { "$value": "#262626" },
      "gray-092": { "$value": "#141414" },
      "gray-dark-mid": { "$value": "#929292" },
      "red": { "$value": "#ff0d0d", "$description": "Medido. 3,9:1 sobre branco: só borda e ícone." },
      "red-text": { "$value": "#d40000", "$description": "Derivado para texto de erro (5,5:1 sobre branco)." },
      "red-text-dark": { "$value": "#ff5c5c", "$description": "Derivado para texto de erro no tema escuro." }
    },
    "light": {
      "base": { "$value": "{color.primitive.white}", "$description": "Fundo da página." },
      "surface": { "$value": "{color.primitive.white}", "$description": "Painéis, modais, gavetas." },
      "muted": { "$value": "{color.primitive.gray-005}", "$description": "Fundo de mídia e esqueleto." },
      "content": { "$value": "{color.primitive.black}", "$description": "Texto e ícones." },
      "content-mid": { "$value": "{color.primitive.gray-060}", "$description": "Texto secundário (5,7:1)." },
      "content-low": { "$value": "{color.primitive.gray-058}", "$description": "Rótulos de campo (5,3:1)." },
      "content-disabled": { "$value": "{color.primitive.gray-040}" },
      "line": { "$value": "{color.primitive.black}", "$description": "Contorno de botão e divisores fortes." },
      "line-subtle": { "$value": "{color.primitive.gray-010}", "$description": "Divisores." },
      "line-field": { "$value": "{color.primitive.gray-055}", "$description": "Linha inferior de campo (4,3:1)." },
      "inverse": { "$value": "{color.primitive.black}", "$description": "Fundo do botão primário." },
      "on-inverse": { "$value": "{color.primitive.white}" },
      "inverse-hover": { "$value": "{color.primitive.gray-080}" },
      "danger": { "$value": "{color.primitive.red}" },
      "danger-text": { "$value": "{color.primitive.red-text}" },
      "overlay": { "$value": "rgba(0, 0, 0, 0.5)" }
    },
    "dark": {
      "base": { "$value": "{color.primitive.black}" },
      "surface": { "$value": "{color.primitive.gray-092}" },
      "muted": { "$value": "{color.primitive.gray-085}" },
      "content": { "$value": "{color.primitive.white}" },
      "content-mid": { "$value": "{color.primitive.gray-dark-mid}" },
      "content-low": { "$value": "{color.primitive.gray-dark-mid}" },
      "content-disabled": { "$value": "{color.primitive.gray-060}" },
      "line": { "$value": "{color.primitive.white}" },
      "line-subtle": { "$value": "{color.primitive.gray-085}" },
      "line-field": { "$value": "{color.primitive.gray-dark-mid}" },
      "inverse": { "$value": "{color.primitive.white}" },
      "on-inverse": { "$value": "{color.primitive.black}" },
      "inverse-hover": { "$value": "{color.primitive.gray-020}" },
      "danger": { "$value": "{color.primitive.red}" },
      "danger-text": { "$value": "{color.primitive.red-text-dark}" },
      "overlay": { "$value": "rgba(0, 0, 0, 0.75)" }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Helvetica Neue", "Helvetica", "Arial", "sans-serif"],
        "$description": "A referência usa Helvetica Now Text (licenciada, não distribuída aqui). Troque este token se tiver a licença."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "light": { "$value": 300, "$description": "Peso padrão de todo o texto." },
      "regular": { "$value": 400 },
      "medium": { "$value": 500, "$description": "Item selecionado." }
    }
  },
  "text": {
    "$type": "typography",
    "caption": { "$value": { "fontSize": "10px", "lineHeight": "16px" }, "$description": "Texto legal e microrrótulos." },
    "label-s": { "$value": { "fontSize": "11px", "lineHeight": "16px" }, "$description": "Nome e preço no cartão, breadcrumbs, rodapé." },
    "label": { "$value": { "fontSize": "12px", "lineHeight": "16px" }, "$description": "Rótulo de campo, texto de apoio." },
    "action": { "$value": { "fontSize": "13px", "lineHeight": "16px" }, "$description": "Botões, links de navegação, abas. Em maiúsculas." },
    "body": { "$value": { "fontSize": "13px", "lineHeight": "20px" }, "$description": "Texto corrido." },
    "title-s": { "$value": { "fontSize": "15px", "lineHeight": "24px" }, "$description": "Título de formulário e de seção." },
    "title": { "$value": { "fontSize": "16px", "lineHeight": "24px" } },
    "heading": { "$value": { "fontSize": "20px", "lineHeight": "24px" } },
    "display": { "$value": { "fontSize": "24px", "lineHeight": "28px" } }
  },
  "space": {
    "$type": "dimension",
    "$description": "Base 4px. Coincide com a escala numérica do Tailwind (1 = 4px).",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px", "$description": "Calha da grelha de produtos no desktop." },
    "18": { "$value": "72px", "$description": "Separação entre blocos de formulário." }
  },
  "size": {
    "$type": "dimension",
    "control-s": { "$value": "32px", "$description": "Altura de botão (medida)." },
    "control-m": { "$value": "40px", "$description": "Altura de campo (medida)." },
    "control-touch": { "$value": "44px", "$description": "Alvo mínimo em toque (WCAG 2.5.5), não medido." },
    "icon": { "$value": "20px" },
    "line": { "$value": "1px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px", "$description": "Único raio do sistema." }
  },
  "motion": {
    "duration-fast": { "$type": "duration", "$value": "200ms", "$description": "Opacidade e hover." },
    "duration-base": { "$type": "duration", "$value": "500ms", "$description": "Painéis, gavetas, carrossel." },
    "easing": { "$type": "cubicBezier", "$value": [0.42, 0, 0.58, 1], "$description": "ease-in-out." }
  },
  "breakpoint": {
    "$type": "dimension",
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1920px" }
  },
  "z": {
    "$type": "number",
    "raised": { "$value": 1 },
    "sticky": { "$value": 10 },
    "overlay": { "$value": 1200 },
    "toast": { "$value": 1300 }
  }
}
